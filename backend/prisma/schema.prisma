generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  created_at  DateTime     @default(now())
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid())
  action     String
  role_id    String
  created_at DateTime @default(now())
  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([action, role_id])
  @@map("permissions")
}

model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  password_hash          String
  role_id                String
  is_2fa_enabled         Boolean                  @default(false)
  twofa_secret           String?
  password_changed_at    DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  deleted_at             DateTime?
  api_keys               ApiKey[]
  audit_logs             AuditLog[]
  email_verifications    EmailVerificationToken[]
  homepage_grids_updated HomepageGrid[]
  login_history          LoginHistory[]
  news_updated           News[]                   @relation("NewsUpdater")
  news_created           News[]                   @relation("NewsAuthor")
  news_revisions         NewsRevision[]
  notifications          Notification[]
  password_resets        PasswordResetToken[]
  refresh_tokens         RefreshToken[]
  sessions               Session[]
  role                   Role                     @relation(fields: [role_id], references: [id])

  @@index([email])
  @@index([deleted_at])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String
  expires_at  DateTime
  revoked_at  DateTime?
  replaced_by String?
  created_at  DateTime  @default(now())
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model Session {
  id            String   @id @default(uuid())
  user_id       String
  session_token String   @unique
  ip_address    String
  user_agent    String?
  expires_at    DateTime
  created_at    DateTime @default(now())
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_token])
  @@map("sessions")
}

model LoginHistory {
  id         String   @id @default(uuid())
  user_id    String?
  ip_address String
  user_agent String?
  status     String
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@map("login_history")
}

model FailedLogin {
  id           String    @id @default(uuid())
  ip_address   String
  email        String
  count        Int       @default(1)
  locked_until DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@unique([ip_address, email])
  @@index([ip_address])
  @@map("failed_logins")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  user_id     String
  token_hash  String
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime  @default(now())
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key_hash   String    @unique
  user_id    String
  is_active  Boolean   @default(true)
  expires_at DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("api_keys")
}

model Media {
  id                String      @id @default(uuid())
  file_name         String
  original_name     String
  file_path         String
  mime_type         String
  file_signature    String?
  file_size         Int
  width             Int?
  height            Int?
  path_webp         String?
  path_avif         String?
  path_thumb        String?
  path_medium       String?
  path_large        String?
  processing_status String      @default("pending")
  created_at        DateTime    @default(now())
  seo_images        News[]      @relation("NewsSeoImage")
  news_documents    News[]      @relation("NewsDocument")
  news_thumbnails   News[]      @relation("NewsThumbnail")
  news_images       NewsImage[]

  @@index([created_at])
  @@map("media")
}

model Category {
  id             String        @id @default(uuid())
  name           String        @unique
  slug           String        @unique
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  homepage_grids HomepageGrid?
  news           News[]

  @@index([slug])
  @@map("categories")
}

model Tag {
  id         String    @id @default(uuid())
  name       String    @unique
  slug       String    @unique
  created_at DateTime  @default(now())
  news_tags  NewsTag[]

  @@index([slug])
  @@map("tags")
}

model News {
  id                   String         @id @default(uuid())
  title                String
  slug                 String         @unique
  excerpt              String?
  content              String
  youtube_url          String?
  category_id          String
  created_by           String
  updated_by           String?
  thumbnail_media_id   String?
  document_media_id    String?
  seo_title            String?
  seo_description      String?
  meta_keywords        String?
  canonical_url        String?
  seo_image_media_id   String?
  status               String         @default("draft")
  visibility           String         @default("public")
  is_featured          Boolean        @default(false)
  is_pinned            Boolean        @default(false)
  is_breaking          Boolean        @default(false)
  featured_order       Int?
  allow_comments       Boolean        @default(true)
  language             String         @default("en")
  publish_version      Int            @default(1)
  scheduled_publish_at DateTime?
  published_at         DateTime?
  views_count          Int            @default(0)
  likes_count          Int            @default(0)
  shares_count         Int            @default(0)
  reading_time         Int?
  deleted_at           DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  content_font         String?        @default("Inter")
  excerpt_font         String?        @default("Inter")
  title_font           String?        @default("Inter")
  author_name          String?
  seo_image            Media?         @relation("NewsSeoImage", fields: [seo_image_media_id], references: [id])
  document             Media?         @relation("NewsDocument", fields: [document_media_id], references: [id])
  thumbnail            Media?         @relation("NewsThumbnail", fields: [thumbnail_media_id], references: [id])
  updated_by_user      User?          @relation("NewsUpdater", fields: [updated_by], references: [id])
  author               User           @relation("NewsAuthor", fields: [created_by], references: [id])
  category             Category       @relation(fields: [category_id], references: [id])
  images               NewsImage[]
  revisions            NewsRevision[]
  tags                 NewsTag[]
  unique_views         NewsView[]

  @@index([slug])
  @@index([status, published_at])
  @@index([is_featured, created_at(sort: Desc)])
  @@index([category_id, created_at(sort: Desc)])
  @@index([category_id, status, published_at(sort: Desc)])
  @@index([created_by])
  @@index([deleted_at])
  @@index([scheduled_publish_at])
  @@map("news")
}

model NewsView {
  id         String   @id @default(uuid())
  news_id    String
  ip_address String
  created_at DateTime @default(now())

  news       News     @relation(fields: [news_id], references: [id], onDelete: Cascade)

  @@unique([news_id, ip_address])
  @@index([news_id])
  @@map("news_views")
}

model NewsImage {
  id         String @id @default(uuid())
  news_id    String
  media_id   String
  sort_order Int    @default(0)
  media      Media  @relation(fields: [media_id], references: [id], onDelete: Cascade)
  news       News   @relation(fields: [news_id], references: [id], onDelete: Cascade)

  @@unique([news_id, media_id])
  @@map("news_images")
}

model NewsTag {
  news_id String
  tag_id  String
  tag     Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  news    News   @relation(fields: [news_id], references: [id], onDelete: Cascade)

  @@id([news_id, tag_id])
  @@map("news_tags")
}

model NewsRevision {
  id             String   @id @default(uuid())
  news_id        String
  version_number Int
  title          String
  excerpt        String?
  content        String
  editor_id      String
  created_at     DateTime @default(now())
  editor         User     @relation(fields: [editor_id], references: [id])
  news           News     @relation(fields: [news_id], references: [id], onDelete: Cascade)

  @@unique([news_id, version_number])
  @@index([news_id])
  @@map("news_revisions")
}

model AuditLog {
  id           String   @id @default(uuid())
  user_id      String?
  action       String
  target_table String
  target_id    String?
  old_value    String?
  new_value    String?
  request_id   String?
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())
  user         User?    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([target_table, target_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model SystemSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

model HomepageGrid {
  id             String   @id @default(uuid())
  category_id    String   @unique
  section_title  String
  display_order  Int      @unique
  layout_type    String   @default("FEATURED")
  article_limit  Int      @default(10)
  featured_limit Int      @default(1)
  visibility     String   @default("PUBLIC")
  show_view_all  Boolean  @default(true)
  updated_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  updater        User?    @relation(fields: [updated_by], references: [id])
  category       Category @relation(fields: [category_id], references: [id])

  @@index([display_order])
  @@index([visibility, display_order])
  @@map("homepage_grids")
}

model EditorialRole {
  id            String            @id @default(uuid())
  name          String            @unique
  description   String?
  display_order Int               @default(0)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  members       EditorialMember[]

  @@index([display_order])
  @@map("editorial_roles")
}

model EditorialMember {
  id            String        @id @default(uuid())
  name          String
  role_id       String
  image         String?
  tagline       String?
  email         String?
  contact       String?
  social_link   String?
  display_order Int           @default(0)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  role          EditorialRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([role_id, display_order])
  @@map("editorial_members")
}
